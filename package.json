{
  "name": "local-owner-controls",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "dev": "vite --config ui/vite.config.ts",
    "build:ui": "tsc --project ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "typecheck:ui": "tsc --project ui/tsconfig.json",
    "preview:ui": "vite preview --config ui/vite.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16",
    "three": "0.180.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "motion": "12.43.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/three": "0.180.0"
  }
}
